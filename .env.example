# Скопируйте в .env и при необходимости измените. Все значения имеют разумные умолчания.

# --- порты на хосте
WEB_PORT=8080
# на публичном сервере закройте симулятор от внешнего мира: MOCKS_PORT=127.0.0.1:8081
MOCKS_PORT=8081

# --- база данных
POSTGRES_USER=credit
POSTGRES_PASSWORD=credit
POSTGRES_DB=credit

# --- безопасность (на сервере обязательно смените JWT_SECRET и включите production)
APP_ENV=development
JWT_SECRET=dev-only-secret-change-me-before-deploy
JWT_TTL_MINUTES=480
CORS_ORIGINS=http://localhost:8080

# --- демо
DEMO_MODE=true
SEED_HISTORY=60
PIPELINE_STEP_DELAY_SEC=1.2

# --- внешние источники (симулятор)
INTEGRATION_TIMEOUT_SEC=3
INTEGRATION_RETRIES=2
MOCK_LATENCY_SCALE=1
MOCK_ERROR_RATE=0

# --- файлы
MAX_UPLOAD_MB=10

# --- необязательная LLM с открытыми весами (docker compose --profile ai up -d)
LLM_PROVIDER=none
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen2.5:1.5b-instruct

LOG_LEVEL=INFO
